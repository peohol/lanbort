NEXT_PUBLIC_APP_ENV=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Local Supabase stack (`pnpm db:start`). `pnpm env:local` writes .env with
# the values the running stack generates (including the publishable key).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Server-only key for private object images in Supabase Storage. Never sent to
# the browser; hosted environments keep it in the platform's secret store.
SUPABASE_SECRET_KEY=
MAILPIT_URL=http://127.0.0.1:54324
# Protects scheduled job endpoints. Any value of 32+ characters works locally;
# hosted environments use a generated secret from the platform's secret store.
CRON_SECRET=local-only-not-a-secret-placeholder-value
# Notification e-mail (WP-41). Left out locally and in CI, so no e-mail is
# sent and the e-mail job answers `unavailable`. Hosted environments set all
# three, the API key in the platform's secret store.
# RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM=Lånbort <varsler@example.com>
# APP_URL=https://example.com
# Who runs Lånbort and where people reach them about security and privacy,
# shown on /konto/personvern. Set in the hosting platform, not here.
# OPERATOR_NAME=
# CONTACT_EMAIL=
# Private chat (WP-43) is off until Port C. Local development and CI turn it
# on to build and test it; hosted environments leave it out.
CHAT_ENABLED=true
# Platform stewards (ADR-0011, OD-0023) stay off in hosted environments until
# their passkeys are verified there. Local development and CI turn them on.
# Passkeys also need APP_URL; locally http://localhost:3000, since WebAuthn
# does not work on a bare IP address. WEBAUTHN_RP_ID is only for a passkey
# domain wider than APP_URL's host.
PLATFORM_STEWARDS_ENABLED=true
