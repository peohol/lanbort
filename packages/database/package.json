{
  "name": "@lanbort/database",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc6 --noEmit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run .integration.test.ts",
    "types:generate": "kysely-codegen",
    "types:check": "kysely-codegen --verify"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0"
  }
}
